VITE_API_URL="KANEO_API_URL"
VITE_CLIENT_URL="KANEO_CLIENT_URL"
VITE_TURNSTILE_SITE_KEY="KANEO_TURNSTILE_SITE_KEY"
# Must end at the /panel segment, never deeper — the client appends its own
# sub-path (use-anota-transcript.ts appends /transcript, chat-bubble.tsx
# appends /message). A value ending in /panel/message doubles up to
# /panel/message/message and 404s at runtime with no build-time warning.
# Correct: https://anota-sms-worker.<account>.workers.dev/panel
VITE_ANOTA_PANEL_URL="KANEO_ANOTA_PANEL_URL"
VITE_SENTRY_DSN="KANEO_SENTRY_DSN"
